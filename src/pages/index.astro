---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Problem from "../components/sections/Problem.astro";
import Solution from "../components/sections/Solution.astro";
import Benefits from "../components/sections/Benefits.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Context — все ваши контакты в одном месте"
  description="Помните, где и как вы познакомились, о чём договорились и когда пора напомнить о себе."
>
  <Header />
  <main>
    <Hero />
    <Problem />
    <Solution />
    <Benefits />
    <FinalCta />
  </main>
  <Footer />
</Base>
